API_BASE_URL=https://api.chatvn.online/api

# OAuth 2.0 Web client ID. It must match the audience accepted by the backend.
GOOGLE_SERVER_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# OAuth 2.0 iOS client ID for bundle ID com.cyr.strangerConfide.
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
